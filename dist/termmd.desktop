[Desktop Entry]
Type=Application
TryExec=termmd
Exec=termmd
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
Name=termmd
GenericName=Terminal
Comment=A GPU-accelerated Wayland terminal
Keywords=shell;prompt;command;commandline;cmd;
StartupNotify=true
StartupWMClass=termmd
Actions=New;
X-TerminalArgExec=-e
X-TerminalArgAppId=--app-id=
X-TerminalArgTitle=--title=
X-TerminalArgDir=--working-directory=
X-TerminalArgHold=--hold

[Desktop Action New]
Name=New Terminal
Exec=termmd
